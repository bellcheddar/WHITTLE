%% WHITTLE workflow. Rendered to a static SVG at build time by
%% tools/render_diagram.py; the Mermaid runtime is never loaded on the
%% droplet (spec 8.3). Each node links into its reference row on About.
%% Shape matters: an earlier version fanned Tier 1 into four side-by-side
%% nodes, giving a 1729 x 1146 SVG whose 13px labels landed on screen at
%% about 8px once scaled into the card. The widest row here is three nodes
%% and the diagram runs tall instead, so it renders near its native size.
flowchart TD
    IN["2,500 candidate VHH sequences<br/>500 per target &middot; five targets"]:::input

    IN --> T0

    subgraph T0G ["Tier 0 &middot; sequence &middot; minutes"]
        T0["IMGT numbering and CDRs<br/>camelid hallmark tetrad<br/>liability motifs &middot; charge and pI &middot; disulfides<br/>CDR3 clustering at 90 per cent"]:::tier
    end

    T0 --> T1

    subgraph T1G ["Tier 1 &middot; structure and developability &middot; about an hour per target"]
        T1["NanoBodyBuilder2 model, OpenMM refinement"]:::tier
        T1 --> T1a["TNP developability<br/>PSH &middot; PPC &middot; PNC<br/>surface patches<br/>SWI &middot; Protein-Sol"]:::tier
        T1 --> T1c["AbLang2 nativeness<br/>OASis humanness<br/>nearest experimental<br/>neighbour, TM-align"]:::tier
        T1 --> TM["WHITTLE apparent-Tm model<br/>650 labelled nanobodies<br/>grouped nested CV, per-row error bar<br/>TemStaPro cross-check"]:::model
    end

    T1a --> R1
    T1c --> R1
    TM --> R1

    R1["Tier 1 ranking, within-target percentiles<br/>on specificity, thermostability, expression<br/><b>the top 50 per target go forward</b>"]:::rank

    R1 --> T2

    subgraph T2G ["Tier 2 &middot; co-folding"]
        T2["boltz-community, five seeds each<br/>250 complexes, about 14 hours<br/>cheapest target first, GLP1R to EGFR"]:::tier
        T2 --> T2a["ipTM, pose agreement across seeds<br/>PRODIGY delta G, buried area<br/>epitope bin, shape complementarity<br/>CDR paratope share<br/>PLIP contacts, H-bond density"]:::tier
    end

    T2a -.->|"weak prior, never an<br/>affinity measurement"| R2

    subgraph CG ["Controls"]
        CTRL["Run through the same code<br/>50 CDR-shuffled sequences per target<br/>each co-folded beside its own parent<br/>held-out Tm nanobodies, known binders"]:::control
        CTRL --> CAL["Calibration: how often does a real<br/>candidate beat its own shuffled twin?<br/>An axis that cannot separate the two<br/>is reported, not quietly kept"]:::control
    end

    CAL -.-> R2

    R2["Final ranking<br/>Pareto non-dominated front<br/>Derringer-Suich desirability<br/>axis correlation matrix"]:::rank

    R2 --> OUT["24 candidates per target<br/>five independent rankings, never pooled"]:::output

    classDef input fill:#F5F8FF,stroke:#3457A6,stroke-width:2px,color:#111827
    classDef tier fill:#FFFFFF,stroke:#DDE2EB,stroke-width:1px,color:#434C5A
    classDef model fill:#FFFFFF,stroke:#3457A6,stroke-width:1.5px,color:#111827
    classDef rank fill:#F5F8FF,stroke:#3457A6,stroke-width:2px,color:#111827
    classDef output fill:#DCF0E4,stroke:#1E4D35,stroke-width:1.5px,color:#1E4D35
    classDef control fill:#FBF0DC,stroke:#B5781C,stroke-width:1.5px,color:#B5781C

    click T0 "#ref-anarci" "ANARCI"
    click T1 "#ref-immunebuilder" "ImmuneBuilder"
    click T1a "#ref-tnp" "TNP"
    click T1c "#ref-ablang2" "AbLang2"
    click TM "#ref-nanomelt_method" "the thermostability labels"
    click T2 "#ref-boltz2" "boltz-community"
    click T2a "#ref-prodigy" "PRODIGY"
