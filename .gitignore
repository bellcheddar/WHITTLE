# Secrets. The repo is public: spec Section 0.4.
config/deploy.toml
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
known_hosts

# Environments
.pixi/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Data and compute output. The whole directory, deliberately: nothing under
# data/ ever belongs in a public repo. It holds the SQLite build, the gzipped
# models, the co-fold runs, the MSA cache, the manifests, the TNP working
# directories and the downloaded reference databases. Spec 5.3 is explicit that
# SAbDab-nano and PLAbDab-nano are never mirrored here or onto the droplet, and
# listing sub-paths one at a time is how a new stage's output leaks in.
data/
models/
wandb/
boltz_results*/

# App build artefacts
app/static/data/*.json
app/static/vendor/
*.pdb.gz

# OS and editor
.DS_Store
.idea/
.vscode/
*.swp

# Node (only used at build time for the partial Plotly bundle and mermaid-cli)
node_modules/
package-lock.json

# Scratch
tmp/
*.log
tests/qc_screenshots/
