config/deploy.toml
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
known_hosts

# Environments
.pixi/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

